# ==============================================================================
# X-SIEBEN Theme 'sieben' .gitignore
# Schutz gegen WordPress-Core und generierte Dokumente / PDFs
# ==============================================================================

# 1. Strikte PDF-Ausschlüsse (Keine generierten Kundenangebote oder Test-PDFs)
angebote/*.pdf
test_*.pdf
scratch_*.pdf
*.pdf

# 2. WordPress-Core & Uploads (Defensiver Schutz)
/wp-admin/
/wp-includes/
/wp-content/plugins/
/wp-content/uploads/
/wp-content/cache/
/wp-content/upgrade/
wp-config.php
wp-activate.php
wp-blog-header.php
wp-comments-post.php
wp-cron.php
wp-links-opml.php
wp-load.php
wp-login.php
wp-mail.php
wp-settings.php
wp-signup.php
wp-trackback.php
xmlrpc.php
*.sql
*.sqlite
docker-compose*.yml
.env*

# 3. Cache, Builds & Backups
inc/core/crm/assets/cache/
assets/cache/
tcbpdf_backup_*/
tcpdf_backup_*.php
.git_standalone_backup/
inc/core/crm/.git_standalone_backup/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# 4. OS & Editor Artefakte
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
